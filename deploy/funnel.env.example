# Copy to /etc/x-ads-funnel/funnel.env on Oracle.
# Never commit the real secret values.
FUNNEL_DB_PATH=/var/lib/x-ads-funnel/funnel.sqlite3
FUNNEL_ALLOWED_ORIGINS=https://nobutakayamauchi.github.io
FUNNEL_RATE_LIMIT_PER_MINUTE=120
FUNNEL_HASH_SECRET=REPLACE_WITH_RANDOM_SERVER_SECRET
FUNNEL_AUDIT_TOKEN=REPLACE_WITH_SEPARATE_RANDOM_AUDIT_SECRET
